# Ghostty config. All options: `ghostty +show-config --default --docs`

# Built-in theme; same palette as gruvbox.nvim and herdr's gruvbox
theme = Gruvbox Dark
font-size = 18
cursor-style = bar
mouse-hide-while-typing = true

# Set the shell explicitly: the snap build can't resolve the passwd entry on Ubuntu 20.04
# (nsswitch compat+systemd) and would fall back to sh without shell integration.
command = direct:/usr/bin/zsh
shell-integration = zsh

# Lets `ssh` to hosts without Ghostty's terminfo (e.g. the Pi) work
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo,path
